supported_targets = "+native"

import {
  "jaredzhou/mturso",
  "jaredzhou/mturso/server",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/core/test",
} for "test"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)
