import {
  "jaredzhou/mturso/ffi",
  "jaredzhou/mturso/value",
  "moonbitlang/async/raw_fd",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/async",
} for "test"

// 绑定依赖 Turso 的 C ABI（native 动态库），所以本模块只有 native 目标。

supported_targets = "+native"

// 79 = implicit_impl_as_method：derive(Eq, Debug) 在这个 core 版本上的既有告警。
//  9 = struct_never_constructed：`Row` 的字段是私有的，只有查询结果会构造它 ——
//      那部分（Rows）是 ticket #3，落地时把 9 从这里去掉。
//  6 = unused_constructor：`NoRows` 由 query_one / fetch_one 抛 —— 同样是 ticket #3。

warnings = "-79-9-6"

options(
  // 最终链接发生在根包（test / 可执行产物），所以链接参数要挂在这里。
  // 库已复制到仓库内 libs/；换机器/换仓库位置时跑 scripts/fetch-turso-lib.sh 重写此路径。
  link: {
    "native": {
      "cc-link-flags": "-L/home/jared/turso/libs -lturso_sync_sdk_kit -Wl,-rpath,/home/jared/turso/libs",
    },
  },
)
