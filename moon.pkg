import {
  "jaredzhou/mturso/ffi",
  "jaredzhou/mturso/value",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/raw_fd",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
}

import {
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/debug",
  "moonbitlang/core/test",
} for "test"

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/test",
} for "wbtest"

// 绑定依赖 Turso 的 C ABI（native 动态库），所以本模块只有 native 目标。

supported_targets = "+native"

// 79 = implicit_impl_as_method：derive(Eq, Debug) 在这个 core 版本上的既有告警。
//  6 = unused_constructor：`NoRows` 由 query_one / fetch_one 抛 —— 同样是 ticket #3。

warnings = "-79-6"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/cond_var",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/raw_fd",
  ],
)

// Turso 动态库由 ffi/loader.c 在运行期加载，不需要 link flags。
