import {
  "jaredzhou/mturso/ffi",
  "moonbitlang/async/raw_fd",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/async",
} for "test"

// 绑定依赖 Turso 的 C ABI（native 动态库），所以本模块只有 native 目标。

supported_targets = "+native"

options(
  // 最终链接发生在根包（test / 可执行产物），所以链接参数要挂在这里。
  // 库已复制到仓库内 libs/；换机器/换仓库位置时跑 scripts/fetch-turso-lib.sh 重写此路径。
  link: {
    "native": {
      "cc-link-flags": "-L/home/jared/turso/libs -lturso_sync_sdk_kit -Wl,-rpath,/home/jared/turso/libs",
    },
  },
)
